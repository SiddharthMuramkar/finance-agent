{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "regions": ["sin1"],
  "crons": [{ "path": "/api/cron/library-refresh", "schedule": "30 21 * * 1" }],
  "schedules": {
    "health": { "schedule": "*/15 * * * *", "path": "/api/cron/health", "requestMethod": "GET" }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
