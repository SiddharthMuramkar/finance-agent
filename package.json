{
  "name": "finance-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "course:check": "node scripts/check-course.mjs",
    "check": "npm run typecheck && npm run lint && npm run course:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "case-data:import": "node --env-file=.env scripts/import-case-data.mjs",
    "widgets:freeze": "FREEZE=1 vitest run src/widgets/widgets.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@assistant-ui/react": "0.15.32",
    "@formulajs/formulajs": "4.6.1",
    "@neondatabase/serverless": "1.2.0",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
