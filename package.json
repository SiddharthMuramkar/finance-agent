{
  "name": "finance-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-on-build.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "layout:check": "node scripts/layout-check.mjs",
    "course:check": "node scripts/check-course.mjs",
    "course:doc": "node scripts/check-course.mjs --write",
    "check": "npm run typecheck && npm run lint && npm run course:check && node scripts/check-adr-cites.mjs && npm run test && node scripts/check-theme-contrast.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "case-data:import": "node --env-file=.env scripts/import-case-data.mjs",
    "widgets:freeze": "FREEZE=1 vitest run src/widgets/widgets.test.ts",
    "widgets:eval": "node --env-file=.env scripts/widget-eval.mjs",
    "delight:eval": "node --env-file=.env scripts/widget-eval.mjs --set delight",
    "widgets:live": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.genui.config.ts",
    "bank:import": "node --env-file=.env scripts/bank-import.mjs",
    "bank:verify": "node --env-file=.env scripts/bank-verify.mjs",
    "course:refs": "node --env-file=.env scripts/check-references.mjs",
    "library:load": "node --env-file=.env scripts/library-load.mjs",
    "library:blog": "node --env-file=.env scripts/library-blog.mjs",
    "library:pictures": "node --env-file=.env scripts/library-pictures.mjs",
    "library:seed-documents": "node --env-file=.env scripts/library-seed-documents.mjs",
    "library:seed-pictures": "node --env-file=.env scripts/library-seed-pictures.mjs",
    "library:sheets": "node --env-file=.env scripts/library-sheets.mjs",
    "library:embed": "node --env-file=.env scripts/library-embed.mjs",
    "library:score": "node --env-file=.env scripts/library-score.mjs",
    "behaviour": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.behaviour.config.ts",
    "tutor:eval": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.tutor-eval.config.ts",
    "tutor:sweep": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.tutor-sweep.config.ts src/behaviour/tutor-eval/sweep.live.ts",
    "tutor:replay": "node scripts/tutor-replay.mjs",
    "compare:models": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.comparison.config.ts src/comparison/run.live.ts",
    "compare:rules": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.comparison.config.ts src/comparison/run-rules.live.ts",
    "ui:test": "playwright test",
    "ui:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.33",
    "@assistant-ui/react-markdown": "0.14.25",
    "@clerk/nextjs": "7.10.0",
    "@formulajs/formulajs": "4.6.1",
    "@neondatabase/serverless": "1.2.0",
    "@openuidev/lang-core": "1.1.0",
    "@openuidev/react-headless": "0.18.5",
    "@openuidev/react-lang": "1.1.0",
    "@openuidev/react-ui": "0.18.5",
    "@vercel/analytics": "^2.0.1",
    "botid": "1.5.13",
    "drizzle-orm": "0.45.4",
    "htmlparser2": "12.0.0",
    "lucide-react": "1.71.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "ts-fsrs": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@ag-ui/core": {
      "zod": "$zod"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "katex": "0.18.10"
  }
}
