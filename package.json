{
  "name": "finance-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "course:check": "node scripts/check-course.mjs",
    "course:doc": "node scripts/check-course.mjs --write",
    "check": "npm run typecheck && npm run lint && npm run course:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "case-data:import": "node --env-file=.env scripts/import-case-data.mjs",
    "widgets:freeze": "FREEZE=1 vitest run src/widgets/widgets.test.ts",
    "bank:import": "node --env-file=.env scripts/bank-import.mjs",
    "bank:verify": "node --env-file=.env scripts/bank-verify.mjs",
    "course:refs": "node --env-file=.env scripts/check-references.mjs",
    "library:load": "node --env-file=.env scripts/library-load.mjs",
    "library:blog": "node --env-file=.env scripts/library-blog.mjs",
    "library:pictures": "node --env-file=.env scripts/library-pictures.mjs",
    "library:seed-documents": "node --env-file=.env scripts/library-seed-documents.mjs",
    "library:seed-pictures": "node --env-file=.env scripts/library-seed-pictures.mjs",
    "library:sheets": "node --env-file=.env scripts/library-sheets.mjs",
    "library:embed": "node --env-file=.env scripts/library-embed.mjs",
    "library:score": "node --env-file=.env scripts/library-score.mjs",
    "behaviour": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.behaviour.config.ts",
    "compare:models": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.comparison.config.ts src/comparison/run.live.ts",
    "compare:rules": "node --env-file=.env node_modules/vitest/vitest.mjs run -c vitest.comparison.config.ts src/comparison/run-rules.live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@formulajs/formulajs": "4.6.1",
    "@neondatabase/serverless": "1.2.0",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "drizzle-orm": "0.45.4",
    "htmlparser2": "12.0.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "ts-fsrs": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-pgvector": "0.0.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
