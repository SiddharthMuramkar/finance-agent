# Names only. Real values live in .env (gitignored) and in Vercel's env settings.
ANTHROPIC_API_KEY=
# Neon pooled connection, used by the app
DATABASE_URL=
# Neon direct connection, used by migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
# Each person's passcode: name:passcode pairs, separated by commas or new lines (a passcode has no comma).
# The owner's name is "owner". Example: owner:first passcode, test:second passcode, tools:third passcode
PASSCODES=
# The old single passcode: used only while PASSCODES is unset or empty, and signs in as the owner
PASSCODE=
# Signs the sign-in cookie (which carries the Learner id)
SESSION_SECRET=
# Optional, for a local cut-off check only: how long a turn runs before it cuts itself off (ms)
TURN_TIME_BUDGET_MS=
# Optional: Voyage embeddings for Library search (vector half). Without it, search is keyword-only.
VOYAGE_API_KEY=
# Not used. Only for Thesys's paid hosted model (Gateway). Widgets use the free OpenUI renderer and need no key.
THESYS_API_KEY=
