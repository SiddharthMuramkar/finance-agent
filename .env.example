# Names only. Real values live in .env (gitignored) and in Vercel's env settings.
ANTHROPIC_API_KEY=
# Neon pooled connection, used by the app
DATABASE_URL=
# Neon direct connection, used by migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
# The one passcode that opens the Study Workspace
PASSCODE=
# Signs the passcode cookie
SESSION_SECRET=
# Optional, for a local cut-off check only: how long a turn runs before it cuts itself off (ms)
TURN_TIME_BUDGET_MS=
# Optional: Voyage embeddings for Library search (vector half). Without it, search is keyword-only.
VOYAGE_API_KEY=
# Placeholder, not used yet: Thesys Gateway (OpenUI Cloud) inference key, from https://console.thesys.dev/keys.
# Only needed if the widgets move from the free OpenUI library to the paid hosted Gateway. Server-side only.
THESYS_API_KEY=
