# Names only. Real values live in .env (gitignored) and in Vercel's env settings.
# OpenAI: the only model key (the Tutor, compose_widget, picture reading, judges and graders; model gpt-6.1-sol)
OPENAI_API_KEY=
# Neon pooled connection, used by the app
DATABASE_URL=
# Neon direct connection, used by migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED=
# Neon project id: with NEON_API_KEY, the production build snapshots the database before it migrates (scripts/migrate-on-build.mjs)
NEON_PROJECT_ID=
# Neon API key (Vercel: Production only, Sensitive): the snapshot before migrations. A production build with a pending
# migration fails when this or NEON_PROJECT_ID is unset, unless NEON_SNAPSHOT=off
NEON_API_KEY=
# Set to "off" only to migrate in production with no snapshot (e.g. while Neon's API is down); remove it after the deploy
NEON_SNAPSHOT=
# Each person's passcode: name:passcode pairs, separated by commas or new lines (a passcode has no comma).
# The owner's name is "owner". Example: owner:first passcode, test:second passcode, tools:third passcode
PASSCODES=
# The old single passcode: used only while PASSCODES is unset or empty, and signs in as the owner
PASSCODE=
# Signs the sign-in cookie (which carries the Learner id)
SESSION_SECRET=
# Google sign-in (ADR 0014): the OAuth client id from Google Cloud; Google sign-in stays off until this and BETTER_AUTH_SECRET are set
GOOGLE_CLIENT_ID=
# Google sign-in: the OAuth client secret that goes with GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=
# Better Auth (ADR 0014): turns on with Google or the email link; signs its session cookie and keys the hash of each sign-in email address; at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Better Auth: this app's own address, the host written into every emailed sign-in link, e.g. https://www.value-it.xyz (or http://localhost:3000 locally); email links stay off without it
BETTER_AUTH_URL=
# Email-link sign-in (ADR 0014): Resend's API key, set by the Vercel Marketplace Resend integration (Production only); email links stay off without it and EMAIL_FROM
RESEND_API_KEY=
# Email-link sign-in: who sign-in emails come from, on the domain verified in Resend, e.g. Value It <sign-in@value-it.xyz>
EMAIL_FROM=
# Optional, for a local cut-off check only: how long a turn runs before it cuts itself off (ms)
TURN_TIME_BUDGET_MS=
# Optional: Voyage embeddings for Library search (vector half). Without it, search is keyword-only.
VOYAGE_API_KEY=
# Optional: the Better Stack heartbeat URL the 15-minute health check (/api/cron/health) reports to (decision #12). Without it, the check runs and sends nothing.
BETTERSTACK_HEARTBEAT_URL=
# Not used. Only for Thesys's paid hosted model (Gateway). Widgets use the free OpenUI renderer and need no key.
THESYS_API_KEY=
