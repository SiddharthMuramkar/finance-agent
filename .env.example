# Names only. Real values live in .env (gitignored) and in Vercel's env settings.
# OpenAI: the only model key (the Tutor, compose_widget, picture reading, judges and graders; model gpt-6.1-sol)
OPENAI_API_KEY=
# Neon pooled connection, used by the app
DATABASE_URL=
# Neon direct connection, used by migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
# Clerk (issue #33): signs real people in. Clerk runs only when both keys are set (and never in the browser test bed).
# Locally: `clerk env pull --file .env.local` (development instance). On Vercel: test keys in Development, live keys in Production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: the instance's PEM public key (Clerk Dashboard > API keys), so session tokens are checked without a call to Clerk
CLERK_JWT_KEY=
# The passcode door, local and test only (production and Vercel refuse it): name:passcode pairs, separated by commas or
# new lines (a passcode has no comma). The test tools sign in as "tools". Example: tools:a passcode, test:another one
PASSCODES=
# Signs the passcode door's cookie (which carries the Learner id) and the browser test bed's sign-in cookie
SESSION_SECRET=
# Optional, for a local cut-off check only: how long a turn runs before it cuts itself off (ms)
TURN_TIME_BUDGET_MS=
# Optional: Voyage embeddings for Library search (vector half). Without it, search is keyword-only.
VOYAGE_API_KEY=
# Not used. Only for Thesys's paid hosted model (Gateway). Widgets use the free OpenUI renderer and need no key.
THESYS_API_KEY=
