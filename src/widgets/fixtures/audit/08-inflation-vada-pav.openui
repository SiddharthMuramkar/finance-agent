root = Widget("Illustration: what inflation does to prices and to your ₹100", [controls, tabs, note, tasks])
$infl = 6
$years = 10
controls = Stack([infl, years], "row")
infl = Slider("inflationPercent", "Inflation: how fast prices rise each year", 0, 15, 0.5, $infl, "percent")
years = Slider("years", "Years from now", 1, 30, 1, $years, "years")
tabs = Tabs([tabPrice, tabPower])
tabPrice = TabItem("price", "A ₹20 vada pav gets dearer", [priceCalc, priceChart])
tabPower = TabItem("power", "Your ₹100 note buys less", [powerCalc, powerChart])
priceCalc = Calculator("future_value", {amount: 20, ratePercent: $infl, years: $years}, "inr")
prices = Query("calculate_range", {calculator: "future_value", inputs: {amount: 20, ratePercent: $infl, years: 1}, vary: "years", from: 1, to: $years, step: 1, currency: "inr"}, {rows: [], output: "", outputs: [], error: ""})
priceChart = LineChart(prices.rows.label, [Series("Price of a vada pav that costs ₹20 today", prices.rows.value)], "natural", "Years from now", "Rupees")
powerCalc = Calculator("present_value", {amount: 100, ratePercent: $infl, years: $years}, "inr")
power = Query("calculate_range", {calculator: "present_value", inputs: {amount: 100, ratePercent: $infl, years: 1}, vary: "years", from: 1, to: $years, step: 1, currency: "inr"}, {rows: [], output: "", outputs: [], error: ""})
powerChart = BarChart(power.rows.label, [Series("What ₹100 then buys, in today's rupees", power.rows.value)], "grouped", "Years from now", "Today's rupees")
note = TextCallout("info", "One idea, two views", "Prices going up and money buying less are the same thing seen from two sides. The note still says ₹100. It just buys fewer vada pavs.")
tasks = GuidedTasks([t1, t2, t3])
t1 = GuidedTask("Set inflation to 0%: nothing changes, ever", $infl == 0)
t2 = GuidedTask("Set inflation to 3% and look 20 years out", $infl == 3 && $years == 20)
t3 = GuidedTask("Now try 8% over 20 years: compare how much faster it bites", $infl == 8 && $years == 20)
