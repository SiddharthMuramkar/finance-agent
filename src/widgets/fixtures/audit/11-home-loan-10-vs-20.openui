root = Widget("A ₹20 lakh home loan: 10 years vs 20 years", [rate, cards, chart, note, tasks])
$rate = 8.5
rate = Slider("ratePercent", "Interest rate (assumed)", 5, 14, 0.25, $rate, "percent")
cards = Stack([c10, c20], "row")
c10 = Card([InlineHeader("10-year loan", "Higher EMI, paid off sooner"), Calculator("emi", {principal: 2000000, ratePercent: $rate, years: 10}, "inr")])
c20 = Card([InlineHeader("20-year loan", "Lower EMI, paid for longer"), Calculator("emi", {principal: 2000000, ratePercent: $rate, years: 20}, "inr")])
interest = Query("calculate_range", {calculator: "emi", inputs: {principal: 2000000, ratePercent: $rate, years: 10}, vary: "years", from: 5, to: 30, step: 5, output: "Total interest", currency: "inr"}, {rows: [], output: "", outputs: [], error: ""})
chart = BarChart(interest.rows.label, [Series("Total interest paid", interest.rows.value)], "grouped", "Loan length", "Rupees")
note = TextCallout("info", "The trade-off", "A longer loan lowers the monthly EMI but you keep paying interest for more years, so the total interest climbs steeply.")
tasks = GuidedTasks([t1, t2])
t1 = GuidedTask("Drop the rate to 7%: how much does the gap in total interest shrink?", $rate == 7)
t2 = GuidedTask("Raise it to 11%: watch the 20-year loan's interest balloon", $rate == 11)
