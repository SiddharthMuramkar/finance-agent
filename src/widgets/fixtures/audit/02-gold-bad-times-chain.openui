root = Widget("Illustration: why gold attracts buyers in bad times", [tabs])
tabs = Tabs([chainTab, compareTab, catchTab])
chainTab = TabItem("chain", "The chain of reasoning", [chain])
compareTab = TabItem("compare", "Gold vs other assets", [compare])
catchTab = TabItem("catch", "The catch", [catches])
chain = Steps([s1, s2, s3, s4])
s1 = StepsItem("1. Bad times arrive", "A recession, a banking scare, a war, a currency crisis. People start asking: will the people I've lent to, or invested with, actually pay?")
s2 = StepsItem("2. Promises look weaker", "A bank deposit is the bank's promise. A bond is a borrower's promise. A share is a claim on a company's future profits. In bad times, all of these promises look less certain.")
s3 = StepsItem("3. People look for something that isn't a promise", "Gold doesn't depend on any company, bank or government paying. Nobody can print more of it, and it's bought and sold everywhere in the world.")
s4 = StepsItem("4. Demand for gold rises", "More people want to hold it for safety, so they're willing to pay more for it. This is called a flight to safety.")
compare = Table([Col("Asset", assets), Col("Is it someone's promise?", promise), Col("Pays you income?", income), Col("Can more be created easily?", printed)])
assets = ["Bank deposit", "Government bond", "Company share", "Gold"]
promise = ["Yes: the bank's", "Yes: the government's", "A claim on a firm's profits", "No"]
income = ["Interest", "Interest", "Dividends, maybe", "Nothing"]
printed = ["Yes: banks create deposits by lending", "Yes: governments can borrow more", "Yes: firms can issue more shares", "Only by slow, costly mining"]
catches = Stack([c1, c2, c3])
c1 = TextCallout("warning", "Gold pays nothing", "While you hold gold, you give up the interest a deposit or bond would pay. The higher interest rates are, the more holding gold costs you in lost income.")
c2 = TextCallout("warning", "Gold doesn't always rise in bad times", "Its price depends on what other buyers will pay. It can fall sharply too, and it has gone through long stretches of falling.")
c3 = TextCallout("info", "In India there's a second reason", "Gold is priced in dollars worldwide. When the rupee weakens, gold costs more in rupees, so Indian households have long treated it as protection against a weaker rupee and rising prices.")
