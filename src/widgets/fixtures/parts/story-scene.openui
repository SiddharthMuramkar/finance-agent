root = Widget("The day before the decision", [scene])
scene = StoryScene([{id: "fed", emoji: "bank", name: "The central bank", role: "sets the rate"}, {id: "saver", emoji: "woman", name: "Asha", role: "owns bonds"}], [{who: "narrator", says: "It is February, and everyone expects calm.", emoji: "calendar"}, {who: "narrator", says: "Tomorrow, the central bank gives its decision."}, {who: "saver", says: "If the rate rises, my old bonds lose their shine.", emoji: "worried-face"}], "Everyone waits for tomorrow's decision", "1994-02-03")
