root = Widget("What does a SIP of ₹1,000 a month end at?", [years, gain])
$years = 20
years = Slider("years", "Years you keep investing", 1, 30, 1, $years, "years")
r = Query("calculate", {calculator: "sip", inputs: {monthly: 1000, ratePercent: 10, years: $years}}, {rows: []})
gain = Stat("Maturity value", @First(r.rows.value), "inr", "At 10% a year (made up)", "you")
